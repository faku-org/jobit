# Copiá este archivo a api/.env y completá lo que necesites.
#
# Tiene que ser api/.env y no el de la raíz: la API arranca con
# `bun run --cwd api start`, así que Bun carga el .env del directorio api.
# El de la raíz no lo ve. api/.env está en el gitignore; este ejemplo no.

# Puerto y dirección donde escucha.
# Por defecto 127.0.0.1: en producción va detrás de nginx, y escuchar en
# 0.0.0.0 la expondría directo y haría falsificable el x-forwarded-for con el
# que el limitador cuenta las peticiones. Ponelo en 0.0.0.0 solo a sabiendas.
PORT=3000
HOST=127.0.0.1

# Orígenes que pueden llamar a la API, separados por coma.
# En producción: https://jobs.wefaber.net
CORS_ORIGIN=http://localhost:5173

# Dónde están los datos. Los tres tienen default y salvo que los muevas de
# lugar no hace falta tocarlos.
# JOBS_FILE=../worker/output/jobs.json
# STATS_FILE=../data/stats.jsonl
# EVENTS_FILE=../data/events.jsonl
# DB_FILE=../data/jobit.db

# --- Panel de administración ---------------------------------------------
#
# Sin ADMIN_PASSWORD_HASH el panel queda apagado entero y /api/admin contesta
# 404. Es a propósito: un despliegue al que se le olvidó configurarlo se queda
# sin admin, no con un admin abierto.
#
# El hash se genera con:
#   bun -e 'await Bun.write("../data/admin.hash", await Bun.password.hash(prompt("clave: ")))'
#
# OJO: el hash argon2id trae varios $ adentro, y el parser de .env de Bun los
# expande como variables. Las comillas NO protegen, ni simples ni dobles:
# el valor queda en "=19=65536,t=2,p=1..." y la clave deja de coincidir sin un
# solo error que lo explique. Probado, no es teoría.
#
# La salida limpia es apuntar a un archivo que tenga el hash y nada más, que
# nadie interpola en el camino. Es lo recomendado, y en producción lo único
# que conviene usar:
# ADMIN_PASSWORD_HASH_FILE=../data/admin.hash
#
# Si igual lo querés inline, hay que escapar cada $ como \$ (las comillas son
# indistintas, lo que importa es el backslash):
# ADMIN_PASSWORD_HASH=\$argon2id\$v=19\$m=65536,t=2,p=1\$...

# Saca el flag `secure` de la cookie de sesión, que sobre http:// la haría
# inservible. Solo para desarrollo. En producción no se pone.
# ADMIN_INSECURE_COOKIES=true

# --- Búsqueda semántica --------------------------------------------------
#
# Embedder propio (EmbeddingGemma 2) servido en el VPS. Todos tienen default:
# el servicio corre en 127.0.0.1:8891 y solo hace falta tocar algo si lo movés.
# EMBEDDER_URL=http://127.0.0.1:8891/v1/embeddings
# EMBEDDER_MODEL=embeddinggemma-2
#
# Cuántos textos por pedido al embedder y cuánto se espera la respuesta.
# EMBEDDER_BATCH=16
# EMBEDDER_TIMEOUT_MS=30000
#
# Peso de lo semántico (0..1) frente al ranking del feed cuando en /api/search
# llegan los rank_*. 0.6 = manda la consulta, pero se desempata por preferencias.
# SEMANTIC_WEIGHT=0.6
#
# Los vectores se llenan (y se actualizan) con:
#   bun run --cwd api embed          # solo las ofertas nuevas
#   bun run --cwd api embed --force  # reembebe todo
