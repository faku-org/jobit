# Copiá este archivo a worker/.env y completá lo que necesites.
#
# Solo hace falta para `bun run push`, que sube el resultado del scrapeo a la
# API. El scrapeo en sí (`bun run scrape`) no necesita nada de acá.
#
# Existe porque BuscoJobs contesta 403 a la IP del VPS: el worker corre en una
# máquina común y lo que produce viaja por HTTP. Del otro lado está
# api/src/ingest.ts, que sin token configurado responde 404.

# A dónde se sube. En producción:
#   JOBIT_INGEST_URL=https://jobs.wefaber.net/api/ingest/jobs
JOBIT_INGEST_URL=http://localhost:3000/api/ingest/jobs

# El mismo valor que INGEST_TOKEN_FILE del lado de la API. Se genera con:
#   bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
JOBIT_INGEST_TOKEN=
