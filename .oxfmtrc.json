{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "semi": false,
  "tabWidth": 2,
  "trailingComma": "all",
  "sortPackageJson": false,
  "ignorePatterns": [
    "data/",
    "*.sql",
    "graphify-out/",
    ".codegraph/",
    ".claude/",
    ".agents/",
    ".tmp-shots/",
    "bun.lock"
  ]
}
