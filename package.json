{
  "name": "jobit",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "worker"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun run --cwd api dev",
    "dev:web": "bun run --cwd web dev",
    "build": "bun run --cwd web build",
    "typecheck": "bun run --cwd api typecheck && bun run --cwd web typecheck && bun run --cwd worker typecheck",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "scrape": "bun run --cwd worker scrape"
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "typescript": "~6.0.2"
  }
}
