[Unit]
Description=JobIt API
Documentation=https://github.com/faku-org/jobit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jobit
Group=jobit
WorkingDirectory=/srv/jobit
# Bun propio en /opt/bun: ProtectHome=true aísla /home, donde vive el bun de
# hermes (~/.bun/bin/bun, symlink en /usr/local/bin/bun). Tras un upgrade de
# bun de hermes, refrescar con: sudo cp $(readlink -f /usr/local/bin/bun) /opt/bun/bun
ExecStart=/opt/bun/bun run api/src/index.ts
Restart=on-failure
RestartSec=5

# Solo escucha en loopback: nginx es el único que llega, y por eso el
# x-forwarded-for que el limitador usa para contar es confiable.
Environment=HOST=127.0.0.1
# 3200: en el VPS de producción el 3000 ya lo usa gantt (OhMyGantt).
Environment=PORT=3200
Environment=CORS_ORIGIN=https://jobs.wefaber.net
Environment=JOBS_FILE=/srv/jobit/worker/output/jobs.json
Environment=STATS_FILE=/srv/jobit/data/stats.jsonl
Environment=EVENTS_FILE=/srv/jobit/data/events.jsonl
Environment=DB_FILE=/srv/jobit/data/jobit.db

# La clave del panel: un archivo con el hash argon2id y nada más. Se apunta a
# un archivo y no a la variable directa porque el hash trae varios $ y casi
# todo lo que lo transporta los interpola (el shell y el parser de .env de Bun
# seguro, con comillas o sin ellas). Un archivo no lo toca nadie.
# Sin esto el panel queda apagado y /api/admin da 404.
#   bun -e 'await Bun.write("/srv/jobit/data/admin.hash", await Bun.password.hash(prompt("clave: ")))'
#   chown jobit:jobit /srv/jobit/data/admin.hash && chmod 600 /srv/jobit/data/admin.hash
Environment=ADMIN_PASSWORD_HASH_FILE=/srv/jobit/data/admin.hash

# El token con el que el worker sube jobs.json desde afuera. Va a un archivo
# por la misma razón que el hash, y sin él /api/ingest contesta 404.
#   bun -e 'await Bun.write("/srv/jobit/data/ingest.token", crypto.randomUUID() + crypto.randomUUID())'
#   chown jobit:jobit /srv/jobit/data/ingest.token && chmod 600 /srv/jobit/data/ingest.token
Environment=INGEST_TOKEN_FILE=/srv/jobit/data/ingest.token

# Aislamiento. ProtectSystem=strict deja todo el disco de solo lectura salvo
# lo que se liste abajo: donde se escriben las estadísticas, y desde que la
# ingesta existe, también donde vive jobs.json. El scrapeo corre afuera y sube
# el archivo, así que ahora es la API la que lo escribe.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ReadWritePaths=/srv/jobit/data /srv/jobit/worker/output
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Bun compila en caliente y necesita páginas de memoria escribibles y
# ejecutables: con esto en true el servicio no arranca.
MemoryDenyWriteExecute=false

LimitNOFILE=8192
# 512M alcanzaba para servir. La ingesta descomprime cinco megas de JSON, los
# parsea y los vuelve a serializar, y ese pico entra acá adentro.
MemoryMax=768M

[Install]
WantedBy=multi-user.target
